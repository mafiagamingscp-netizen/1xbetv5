{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid"
        },
        "balance": {
          ".write": false
        }
      }
    },
    "depositRequests": {
      ".read": false,
      ".write": false
    },
    "withdrawalRequests": {
      ".read": false,
      ".write": false
    },
    "gameSettings": {
      ".read": true,
      ".write": false
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}